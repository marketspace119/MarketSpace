rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActive() {
      return isSignedIn() &&
        'status' in request.auth.token &&
        request.auth.token.status == 'active' &&
        request.auth.token.status != 'suspended' &&
        request.auth.token.status != 'banned' &&
        request.auth.token.status != 'disabled' &&
        (!('disabled' in request.auth.token) || request.auth.token.disabled != true);
    }

    function isAdmin() {
      return isActive() &&
        request.auth.token.email_verified == true && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          ('role' in request.auth.token && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN'))
        );
    }

    function isImage() {
      return request.resource != null &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif)') &&
             request.resource.size <= 5 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User avatars (ALL writes & deletes mediated exclusively via /api/images/upload -> Admin SDK; ALL client direct writes denied)
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Seller isolated storage (ALL writes & deletes mediated exclusively via /api/images/upload -> Admin SDK; ALL client direct writes denied)
    match /sellers/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Store assets (ALL writes mediated exclusively via /api/images/upload -> Admin SDK; ALL client direct writes denied)
    match /stores/{storeId}/{fileName} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // Product images (ALL writes mediated exclusively via /api/images/upload -> Admin SDK; ALL client direct writes denied)
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
