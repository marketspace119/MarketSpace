rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUserDocActive(userData) {
      return (!('status' in userData) || (
        userData.status != 'suspended' &&
        userData.status != 'banned' &&
        userData.status != 'disabled'
      )) &&
      (!('disabled' in userData) || userData.disabled != true);
    }

    // Centralized Account State Verification (P0-02, P0-04, P1-04)
    // Ensures suspended, disabled, or banned users are strictly forbidden from performing client writes
    function isUserActive(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return isSignedIn() && exists(userPath) && isUserDocActive(get(userPath).data);
    }

    function isActiveUser() {
      return isSignedIn() && isUserActive(request.auth.uid);
    }

    function isSuperAdmin() {
      let uid = request.auth.uid;
      let adminPath = /databases/$(database)/documents/admins/$(uid);
      let userPath = /databases/$(database)/documents/users/$(uid);
      return isSignedIn() &&
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) &&
        isUserActive(uid) && (
          (exists(adminPath) && get(adminPath).data.role == 'SUPER_ADMIN') ||
          (exists(userPath) && get(userPath).data.role == 'SUPER_ADMIN')
        );
    }

    function isAdmin() {
      let uid = request.auth.uid;
      let adminPath = /databases/$(database)/documents/admins/$(uid);
      let userPath = /databases/$(database)/documents/users/$(uid);
      return isSignedIn() &&
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) &&
        isUserActive(uid) && (
          (exists(adminPath) && (get(adminPath).data.role in ['ADMIN', 'SUPER_ADMIN'])) ||
          (exists(userPath) && (get(userPath).data.role in ['ADMIN', 'SUPER_ADMIN']))
        );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().role == 'CUSTOMER' || isSuperAdmin()
      ) && incoming().id == userId &&
      (!('isVerified' in incoming()) || incoming().isVerified == false) &&
      (!('sellerStatus' in incoming()) || incoming().sellerStatus == 'INACTIVE' || incoming().sellerStatus == 'NONE') &&
      (!('permissions' in incoming()) || incoming().permissions == null) &&
      (!('balance' in incoming()) || incoming().balance == 0);

      allow update: if isSignedIn() && (
        // Active Customer updating their own profile (strictly non-privilege fields)
        (request.auth.uid == userId &&
         isUserActive(userId) &&
         incoming().id == existing().id &&
         incoming().role == existing().role &&
         (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified) &&
         (!('sellerStatus' in incoming()) || incoming().sellerStatus == existing().sellerStatus) &&
         (!('permissions' in incoming()) || incoming().permissions == existing().permissions) &&
         (!('balance' in incoming()) || incoming().balance == existing().balance) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'name', 'phone', 'avatar', 'updatedAt', 'addresses', 'preferredLanguage'
         ])) ||
        // Super Admin profile updates (status/disabled must go through backend gateway)
        (isSuperAdmin() &&
         incoming().id == existing().id &&
         incoming().role == existing().role &&
         (!('status' in incoming()) || incoming().status == existing().status) &&
         (!('disabled' in incoming()) || incoming().disabled == existing().disabled) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'name', 'phone', 'avatar', 'notes', 'updatedAt', 'addresses', 'preferredLanguage'
         ])) ||
        // Regular Admin CANNOT modify role, isVerified, sellerStatus, permissions, balance, OR status (OPEN-01)
        (isAdmin() &&
         incoming().id == existing().id &&
         incoming().role == existing().role &&
         (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified) &&
         (!('sellerStatus' in incoming()) || incoming().sellerStatus == existing().sellerStatus) &&
         (!('permissions' in incoming()) || incoming().permissions == existing().permissions) &&
         (!('balance' in incoming()) || incoming().balance == existing().balance) &&
         (!('status' in incoming()) || incoming().status == existing().status) &&
         (!('disabled' in incoming()) || incoming().disabled == existing().disabled) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'name', 'phone', 'avatar', 'notes', 'updatedAt', 'addresses'
         ]))
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Admins Registry (Server-side authoritative only)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 3. Seller Applications
    match /sellerApplications/{applicationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 4. Stores Collection (F-15 Store Financial Metadata Exposure Prevention)
    // Public reads are permitted only when private financial fields (commissionRate, currentPlanId, currentPlanTier)
    // are absent from the public document or the caller is the store owner or platform admin.
    match /stores/{storeId} {
      allow get, list: if (
        (!('commissionRate' in resource.data) &&
         !('currentPlanId' in resource.data) &&
         !('currentPlanTier' in resource.data)) ||
        (isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin()))
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         incoming().sellerId == request.auth.uid &&
         incoming().status in ['pending', 'pending_review'] &&
         incoming().isVerified == false &&
         !('commissionRate' in incoming()) &&
         !('currentPlanId' in incoming()) &&
         !('currentPlanTier' in incoming()) &&
         (!('deliveryFee' in incoming()) || (incoming().deliveryFee >= 0 && incoming().deliveryFee <= 500)))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && incoming().sellerId == existing().sellerId &&
         (!('commissionRate' in incoming()) || (incoming().commissionRate >= 5 && incoming().commissionRate <= 50)) &&
         (!('deliveryFee' in incoming()) || (incoming().deliveryFee >= 0 && incoming().deliveryFee <= 500))) ||
        (isActiveUser() &&
         resource.data.sellerId == request.auth.uid &&
         incoming().sellerId == existing().sellerId &&
         (!('deliveryFee' in incoming()) || (incoming().deliveryFee >= 0 && incoming().deliveryFee <= 500)) &&
         (!('commissionRate' in incoming()) || incoming().commissionRate == existing().commissionRate) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'name', 'description', 'phone', 'whatsapp', 'email', 'city', 'district',
           'address', 'openingHours', 'deliveryAvailable', 'deliveryFee', 'minOrder',
           'logo', 'cover', 'updatedAt'
         ]))
      );
      allow delete: if isAdmin();
    }

    // 4b. Private Store Profiles (F-15 Isolated Financial & Plan Metadata)
    match /privateStoreProfiles/{storeId} {
      allow get, list: if isSignedIn() && (
        (exists(/databases/$(database)/documents/stores/$(storeId)) &&
         get(/databases/$(database)/documents/stores/$(storeId)).data.sellerId == request.auth.uid) ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 5. Products Collection (F-08 Domain State Isolation & F-16 Internal Metadata Privacy)
    // Server-Authoritative Product Creation: All product creations MUST flow through Trusted Backend Gateway (/api/products/create)
    // to enforce subscription plan quotas (maxProducts), store ownership, price/stock validation, and status lifecycle.
    // Direct client creates are strictly forbidden.
    // Public reads are permitted only when internal procurement/audit fields (supplier, inventoryHistory, affiliateUrl)
    // are absent or empty, or when the caller is the product owner or platform admin.
    match /products/{productId} {
      allow get, list: if (
        (!('supplier' in resource.data) &&
         !('affiliateUrl' in resource.data) &&
         (!('inventoryHistory' in resource.data) || resource.data.inventoryHistory == null || resource.data.inventoryHistory.size() == 0)) ||
        (isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin()))
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         resource.data.sellerId == request.auth.uid &&
         incoming().sellerId == existing().sellerId &&
         incoming().storeId == existing().storeId &&
         incoming().price is number && incoming().price > 0 &&
         incoming().stock is number && incoming().stock >= 0 &&
         !('inventoryHistory' in incoming()) &&
         !('salesCount' in incoming()) &&
         (incoming().status == existing().status || (incoming().status in ['draft', 'pending', 'pending_review', 'hidden', 'DRAFT', 'PENDING', 'HIDDEN'])) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'title', 'description', 'price', 'oldPrice', 'discount', 'images', 'thumbnail',
           'category', 'categories', 'stock', 'sizes', 'colors', 'addons', 'status',
           'isOffer', 'features', 'specs', 'updatedAt'
         ]))
      );
      allow delete: if isSignedIn() && ((isActiveUser() && resource.data.sellerId == request.auth.uid) || isAdmin());
    }

    // 5a. Private Product Metadata (F-16 Isolated Supplier & Inventory History)
    match /privateProductMetadata/{productId} {
      allow get, list: if isSignedIn() && (
        (exists(/databases/$(database)/documents/products/$(productId)) &&
         get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid) ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         exists(/databases/$(database)/documents/products/$(productId)) &&
         get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid)
      );
    }

    // 5b. Store Product Quota Locks (Internal Concurrency Lock for maxProducts Enforcement)
    match /store_product_quotas/{storeId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 6. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        (resource.data.sellerIds != null && (request.auth.uid in resource.data.sellerIds)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        (resource.data.sellerIds != null && (request.auth.uid in resource.data.sellerIds)) ||
        isAdmin()
      );
      // Direct client or guest creation is STRICTLY DENIED for ALL clients (guest, customer, seller).
      // All orders MUST be created exclusively via trusted server backend.
      allow create: if false;
      allow update: if isSignedIn() &&
        incoming().customerId == existing().customerId &&
        incoming().total == existing().total &&
        incoming().subtotal == existing().subtotal &&
        incoming().shipping == existing().shipping &&
        incoming().paymentMethod == existing().paymentMethod &&
        incoming().paymentStatus == existing().paymentStatus &&
        incoming().sellerIds == existing().sellerIds &&
        incoming().vendorStoreIds == existing().vendorStoreIds &&
        incoming().vendorOrders == existing().vendorOrders && (
          // Customer can only add delivery notes or cancel their own pending order
          (resource.data.customerId == request.auth.uid &&
           isActiveUser() &&
           (incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
             existing().status == 'pending' &&
             incoming().status == 'cancelled'))) ||
          // Seller can update order status, status history, and delivery tracking code for single-vendor orders, but CANNOT modify vendorOrders or financial fields
          (resource.data.sellerIds != null && resource.data.sellerIds.size() == 1 && (request.auth.uid in resource.data.sellerIds) &&
           isActiveUser() &&
           (incoming().statusHistory == null || incoming().statusHistory is list) &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'status', 'statusHistory', 'deliveryTrackingCode', 'updatedAt'
           ]) &&
           // Forward-only state transition
           (
             (existing().status == 'pending' && (incoming().status in ['confirmed', 'processing', 'preparing', 'cancelled'])) ||
             (existing().status == 'confirmed' && (incoming().status in ['processing', 'preparing', 'ready', 'cancelled'])) ||
             (existing().status == 'processing' && (incoming().status in ['preparing', 'ready', 'shipped', 'out_for_delivery', 'cancelled'])) ||
             (existing().status == 'preparing' && (incoming().status in ['ready', 'shipped', 'out_for_delivery', 'cancelled'])) ||
             (existing().status == 'ready' && (incoming().status in ['out_for_delivery', 'shipped', 'cancelled'])) ||
             ((existing().status == 'shipped' && incoming().status == 'out_for_delivery') || (existing().status == 'out_for_delivery' && incoming().status == 'shipped')) ||
             (existing().status == incoming().status)
           )) ||
          // F-02: Admin CANNOT bypass order state machine transitions
          (isAdmin() &&
           !(existing().status in ['delivered', 'cancelled']) &&
           (
             (existing().status == incoming().status) ||
             (existing().status == 'pending' && (incoming().status in ['confirmed', 'processing', 'preparing', 'cancelled'])) ||
             (existing().status == 'confirmed' && (incoming().status in ['processing', 'preparing', 'ready', 'cancelled'])) ||
             (existing().status == 'processing' && (incoming().status in ['preparing', 'ready', 'shipped', 'out_for_delivery', 'cancelled'])) ||
             (existing().status == 'preparing' && (incoming().status in ['ready', 'shipped', 'out_for_delivery', 'cancelled'])) ||
             (existing().status == 'ready' && (incoming().status in ['out_for_delivery', 'shipped', 'cancelled'])) ||
             (existing().status == 'shipped' && (incoming().status in ['out_for_delivery', 'delivered', 'cancelled'])) ||
             (existing().status == 'out_for_delivery' && (incoming().status in ['delivered', 'cancelled']))
           ) &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'status', 'notes', 'statusHistory', 'deliveryTrackingCode', 'updatedAt'
           ]))
      );
      // Financial record immutability: Orders cannot be deleted
      allow delete: if false;
    }

    // 7. Manual Mobile Money Payment Verification Submissions
    // ALL mutations must strictly flow through Trusted Backend Gateway (/api/payments/*) via Admin SDK.
    // Client SDK direct writes are strictly DENIED (P0 Payment Gateway Bypass Remediation).
    match /paymentSubmissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 7b. Payment References (Anti-Replay Unique Index)
    // Managed exclusively by Trusted Backend Gateway via Firebase Admin SDK.
    match /paymentReferences/{normalizedRef} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 8. Service Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        (('providerId' in resource.data && resource.data.providerId == request.auth.uid) ||
         ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        (('providerId' in resource.data && resource.data.providerId == request.auth.uid) ||
         ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid)) ||
        isAdmin()
      );
      // Server-Authoritative Booking Creation: All creations MUST flow through Trusted Gateway (/api/bookings/create)
      // Direct client creates are strictly forbidden to ensure atomic slot reservation and invariant checks
      allow create: if false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         resource.data.customerId == request.auth.uid &&
         incoming().customerId == existing().customerId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
         incoming().status == 'cancelled' &&
         (existing().status in ['requested', 'accepted', 'confirmed'])) ||
        (isActiveUser() &&
         ('providerId' in resource.data && resource.data.providerId == request.auth.uid) &&
         incoming().customerId == existing().customerId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
         (
           (existing().status == 'requested' && incoming().status in ['accepted', 'confirmed', 'cancelled']) ||
           (existing().status == 'accepted' && incoming().status in ['scheduled', 'in_progress', 'cancelled']) ||
           (existing().status == 'confirmed' && incoming().status in ['scheduled', 'in_progress', 'cancelled']) ||
           (existing().status == 'scheduled' && incoming().status in ['in_progress', 'completed', 'cancelled']) ||
           (existing().status == 'in_progress' && incoming().status in ['completed', 'cancelled']) ||
           (existing().status == incoming().status)
         )) ||
        (isActiveUser() &&
         ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid) &&
         incoming().customerId == existing().customerId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
         (
           (existing().status == 'requested' && incoming().status in ['accepted', 'confirmed', 'cancelled']) ||
           (existing().status == 'accepted' && incoming().status in ['scheduled', 'in_progress', 'cancelled']) ||
           (existing().status == 'confirmed' && incoming().status in ['scheduled', 'in_progress', 'cancelled']) ||
           (existing().status == 'scheduled' && incoming().status in ['in_progress', 'completed', 'cancelled']) ||
           (existing().status == 'in_progress' && incoming().status in ['completed', 'cancelled']) ||
           (existing().status == incoming().status)
         ))
      );
      allow delete: if isAdmin();
    }

    // 8b. Booking Slots Lock Collection (Internal Concurrency Locking)
    // Strictly managed server-side by /api/bookings/create via Admin SDK.
    // Direct client reads and writes are forbidden to prevent booking slot enumeration and spoofing.
    match /booking_slots/{slotId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 8c. Order Disputes Collection (V3-03 & PCR-10 Strictly Server-Authoritative Workflow)
    // All dispute mutations (/api/disputes/create, /api/disputes/respond, /api/disputes/resolve)
    // MUST execute exclusively on the trusted backend via Admin SDK transactions.
    match /disputes/{disputeId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 8d. Order Active Dispute Locks (Internal Concurrency Lock for /api/disputes/create)
    match /dispute_locks/{lockId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 9. Customer Product & Store Reviews (F-03 Privacy & F-04 Update Validation)
    match /reviews/{reviewId} {
      allow get, list: if (
        (!('userId' in resource.data) && !('customerId' in resource.data) && !('orderId' in resource.data) && !('bookingId' in resource.data)) ||
        (isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid) ||
          isAdmin()
        ))
      );
      allow create: if isActiveUser() &&
        (!('customerId' in incoming()) || incoming().customerId == request.auth.uid) &&
        (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
        (('customerId' in incoming()) || ('userId' in incoming())) &&
        (
          ('orderId' in incoming() &&
           incoming().orderId is string &&
           exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
           get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.customerId == request.auth.uid &&
           get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status in ['delivered', 'completed'] &&
           (
             (incoming().targetType == 'product' &&
              'productIds' in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data &&
              get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.productIds is list &&
              incoming().targetId in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.productIds) ||
             (incoming().targetType in ['store', 'restaurant', 'service'] &&
              'vendorStoreIds' in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data &&
              get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.vendorStoreIds is list &&
              incoming().targetId in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.vendorStoreIds)
           )) ||
          ('bookingId' in incoming() &&
           incoming().bookingId is string &&
           exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
           get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == request.auth.uid &&
           get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed' &&
           (
             (incoming().targetType == 'service' &&
              (get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.serviceId == incoming().targetId ||
               get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.storeId == incoming().targetId)) ||
             (incoming().targetType == 'product' &&
              get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.serviceId == incoming().targetId) ||
             (incoming().targetType in ['store', 'restaurant'] &&
              get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.storeId == incoming().targetId)
           ))
        ) &&
        (!('isVerifiedPurchase' in incoming()) || incoming().isVerifiedPurchase == false || isSuperAdmin()) &&
        (!('verifiedPurchase' in incoming()) || incoming().verifiedPurchase == false || isSuperAdmin()) &&
        incoming().targetType in ['product', 'store', 'restaurant', 'service'] &&
        incoming().targetId is string &&
        (
          (incoming().targetType == 'product' && exists(/databases/$(database)/documents/products/$(incoming().targetId))) ||
          (incoming().targetType == 'service' && (exists(/databases/$(database)/documents/products/$(incoming().targetId)) || exists(/databases/$(database)/documents/stores/$(incoming().targetId)))) ||
          (incoming().targetType in ['store', 'restaurant'] && exists(/databases/$(database)/documents/stores/$(incoming().targetId)))
        ) &&
        incoming().rating is number &&
        incoming().rating >= 1 &&
        incoming().rating <= 5 &&
        incoming().comment is string &&
        incoming().comment.size() > 0 &&
        incoming().comment.size() <= 2000;
      allow update: if isSignedIn() && (
        (isAdmin() &&
         (!('rating' in incoming()) || (incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5))) ||
        (isActiveUser() &&
         (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
         (!('customerId' in incoming()) || incoming().customerId == existing().customerId) &&
         (!('userId' in incoming()) || incoming().userId == existing().userId) &&
         (!('orderId' in incoming()) || incoming().orderId == existing().orderId) &&
         (!('bookingId' in incoming()) || incoming().bookingId == existing().bookingId) &&
         (!('targetId' in incoming()) || incoming().targetId == existing().targetId) &&
         (!('targetType' in incoming()) || incoming().targetType == existing().targetType) &&
         (!('isVerifiedPurchase' in incoming()) || incoming().isVerifiedPurchase == existing().isVerifiedPurchase) &&
         (!('verifiedPurchase' in incoming()) || incoming().verifiedPurchase == existing().verifiedPurchase) &&
         incoming().rating is number &&
         incoming().rating >= 1 &&
         incoming().rating <= 5 &&
         (!('comment' in incoming()) || (incoming().comment is string && incoming().comment.size() > 0 && incoming().comment.size() <= 2000)) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt'])) ||
        // Seller reply to customer review: Must be the verified seller of this product/review
        (isActiveUser() &&
         ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['sellerReply', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (
        (isActiveUser() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)) ||
        isAdmin()
      );
    }

    // 9b. Public Review Projections (Sanitized public view without userId, customerId, orderId, bookingId)
    match /reviews_public/{reviewId} {
      allow get, list: if !('userId' in resource.data) && !('customerId' in resource.data) && !('orderId' in resource.data) && !('bookingId' in resource.data);
      allow write: if isAdmin();
    }

    // 10. Notifications Collection (Spoofing prevention: sensitive notifications restricted to server/admin - F-14)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isActiveUser() && incoming().userId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (isActiveUser() &&
         resource.data.userId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && ((isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin());
    }

    // 11. Payout Requests Collection
    match /payoutRequests/{payoutId} {
      allow get: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      // Direct client creation & updates strictly DENIED; must flow through trusted server transaction API (/api/payouts/create & /api/payouts/review) via Admin SDK
      allow create, update, delete: if false;
    }

    // P1-PAYOUT-DATA: Secure Settlement Destinations (Super-Admin Read Only, Server-Only Writes - OPEN-08)
    match /payout_settlement_destinations/{payoutId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // 12. Audit Logs Collection (Unified Schema & Immutability)
    // Server-Only writes via Admin SDK (F-11 Remediation: Client cannot forge audit trails)
    match /audit_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 13. Delivery Assignments Collection (F-10 Strict State-Transition Validation)
    match /deliveryAssignments/{assignmentId} {
      allow get: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        (resource.data.customerId != null && resource.data.customerId == request.auth.uid) ||
        (resource.data.driverId != null && resource.data.driverId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        (resource.data.customerId != null && resource.data.customerId == request.auth.uid) ||
        (resource.data.driverId != null && resource.data.driverId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         incoming().sellerId == request.auth.uid &&
         incoming().orderId is string &&
         exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
         (request.auth.uid in get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.sellerIds) &&
         (!('customerId' in incoming()) || incoming().customerId == get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.customerId) &&
         (incoming().status in ['pending', 'assigned', 'preparing', 'ready', 'PENDING', 'ASSIGNED', 'PREPARING', 'READY']) &&
         (!('driverId' in incoming()) || incoming().driverId == null || (
           exists(/databases/$(database)/documents/drivers/$(incoming().driverId)) &&
           get(/databases/$(database)/documents/drivers/$(incoming().driverId)).data.status in ['active', 'AVAILABLE'] &&
           get(/databases/$(database)/documents/drivers/$(incoming().driverId)).data.sellerId == request.auth.uid
         )))
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         !(existing().status in ['delivered', 'cancelled', 'DELIVERED', 'CANCELLED']) &&
         (
           (existing().status == incoming().status) ||
           ((existing().status in ['pending', 'PENDING']) && (incoming().status in ['assigned', 'preparing', 'ready', 'cancelled', 'ASSIGNED', 'PREPARING', 'READY', 'CANCELLED'])) ||
           ((existing().status in ['assigned', 'ASSIGNED']) && (incoming().status in ['preparing', 'ready', 'picked_up', 'cancelled', 'PREPARING', 'READY', 'PICKED_UP', 'CANCELLED'])) ||
           ((existing().status in ['preparing', 'PREPARING']) && (incoming().status in ['ready', 'cancelled', 'READY', 'CANCELLED'])) ||
           ((existing().status in ['ready', 'READY']) && (incoming().status in ['picked_up', 'out_for_delivery', 'cancelled', 'PICKED_UP', 'OUT_FOR_DELIVERY', 'CANCELLED'])) ||
           ((existing().status in ['picked_up', 'PICKED_UP']) && (incoming().status in ['out_for_delivery', 'failed', 'cancelled', 'OUT_FOR_DELIVERY', 'FAILED', 'CANCELLED'])) ||
           ((existing().status in ['out_for_delivery', 'OUT_FOR_DELIVERY']) && (incoming().status in ['delivered', 'failed', 'DELIVERED', 'FAILED'])) ||
           ((existing().status in ['failed', 'FAILED']) && (incoming().status in ['assigned', 'cancelled', 'ASSIGNED', 'CANCELLED']))
         ) &&
         ((resource.data.sellerId == request.auth.uid &&
           incoming().sellerId == existing().sellerId &&
           incoming().orderId == existing().orderId &&
           (!('customerId' in existing()) || incoming().customerId == existing().customerId) &&
           (!('driverId' in incoming()) || incoming().driverId == null || incoming().driverId == existing().driverId || (
             exists(/databases/$(database)/documents/drivers/$(incoming().driverId)) &&
             get(/databases/$(database)/documents/drivers/$(incoming().driverId)).data.status in ['active', 'AVAILABLE'] &&
             get(/databases/$(database)/documents/drivers/$(incoming().driverId)).data.sellerId == request.auth.uid
           )) &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'driverId', 'assignedDriver', 'driverPhone', 'vehicleInfo', 'deliveryType',
             'status', 'timestamps', 'notes', 'updatedAt', 'proof'
           ])) ||
          (('driverId' in resource.data && resource.data.driverId == request.auth.uid) &&
           incoming().driverId == existing().driverId &&
           incoming().sellerId == existing().sellerId &&
           incoming().orderId == existing().orderId &&
           (!('customerId' in existing()) || incoming().customerId == existing().customerId) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timestamps', 'notes', 'updatedAt', 'proof']))))
      );
      allow delete: if isAdmin();
    }

    // 14. Saved Customer Addresses Collection
    match /addresses/{addressId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        (isActiveUser() && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && ((isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin());
    }

    // 15. Conversations Collection (F-16 & F-21 Conversation Context & Participant Validation)
    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && (
        (('participantIds' in resource.data && (request.auth.uid in resource.data.participantIds)) ||
         ('participants' in resource.data && (request.auth.uid in resource.data.participants))) ||
        isAdmin()
      );
      allow create: if isActiveUser() && (
        incoming().participantIds != null &&
        incoming().participantIds is list &&
        incoming().participantIds.size() == 2 &&
        (request.auth.uid in incoming().participantIds) &&
        incoming().contextType in ['order', 'booking', 'store', 'product', 'general', 'support'] &&
        (
          (incoming().contextType in ['general', 'support']) ||
          (incoming().contextType == 'order' &&
           incoming().contextId is string &&
           exists(/databases/$(database)/documents/orders/$(incoming().contextId)) &&
           (get(/databases/$(database)/documents/orders/$(incoming().contextId)).data.customerId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/orders/$(incoming().contextId)).data.sellerIds) &&
           get(/databases/$(database)/documents/orders/$(incoming().contextId)).data.customerId in incoming().participantIds &&
           incoming().participantIds.hasAny(get(/databases/$(database)/documents/orders/$(incoming().contextId)).data.sellerIds)) ||
          (incoming().contextType == 'booking' &&
           incoming().contextId is string &&
           exists(/databases/$(database)/documents/bookings/$(incoming().contextId)) &&
           (get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.sellerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.providerId == request.auth.uid) &&
           get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.customerId in incoming().participantIds &&
           (get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.sellerId in incoming().participantIds ||
            get(/databases/$(database)/documents/bookings/$(incoming().contextId)).data.providerId in incoming().participantIds)) ||
          (incoming().contextType == 'store' &&
           incoming().contextId is string &&
           exists(/databases/$(database)/documents/stores/$(incoming().contextId)) &&
           get(/databases/$(database)/documents/stores/$(incoming().contextId)).data.sellerId in incoming().participantIds) ||
          (incoming().contextType == 'product' &&
           incoming().contextId is string &&
           exists(/databases/$(database)/documents/products/$(incoming().contextId)) &&
           get(/databases/$(database)/documents/products/$(incoming().contextId)).data.sellerId in incoming().participantIds)
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isActiveUser() &&
         resource.data.participantIds != null && (request.auth.uid in resource.data.participantIds) &&
         incoming().participantIds == existing().participantIds &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'lastMessage', 'lastMessageAt', 'lastSenderId', 'unreadCount', 'updatedAt'
         ]))
      );
      allow delete: if isAdmin();
    }

    // 16. Chat Messages Collection (Strict privacy: Only participants can read messages; senderRole verified)
    match /messages/{messageId} {
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        (resource.data.conversationId != null &&
         exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
         (request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds)) ||
        isAdmin()
      );
      allow create: if isActiveUser() &&
        incoming().senderId == request.auth.uid &&
        (!('senderRole' in incoming()) || (incoming().senderRole != 'ADMIN' && incoming().senderRole != 'SUPER_ADMIN') || isAdmin()) &&
        incoming().text is string &&
        incoming().text.size() > 0 &&
        incoming().text.size() <= 2000 &&
        incoming().conversationId is string &&
        exists(/databases/$(database)/documents/conversations/$(incoming().conversationId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participantIds ||
         isAdmin());
      allow update, delete: if isAdmin();
    }

    // 17. Delivery Drivers Fleet (V3-07 Driver shift status persistence allowed)
    match /drivers/{driverId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == driverId ||
        ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isActiveUser() &&
          request.auth.uid == driverId &&
          incoming().status in ['AVAILABLE', 'OFFLINE'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // 18. Fleet Vehicles (Restricted to associated seller, driver, or admin)
    match /vehicles/{vehicleId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    // 19. Platform Settings Collections & Documents (Tiered Access Isolation - P1-01 & F-11)
    match /platformSettings/{settingId} {
      // Public settings (branding, support contacts, customer pickup/delivery flags)
      allow get: if (settingId == 'public' || settingId == 'publicPlatformSettings' || isAdmin());
      // Operational settings (F-11: restricted to Admin/SuperAdmin; customers receive checkout payment instructions via server gateway)
      allow get: if (settingId == 'operational' || settingId == 'operationalSettings') && isAdmin();
      // Private financial settings (commissions, settlement configs, payout thresholds)
      allow get: if (settingId == 'privateFinancial' || settingId == 'privateFinancialSettings') && isAdmin();
      // Default doc: Strictly Admin only to prevent leaking commission rates & financial policies to regular users
      allow get: if (settingId == 'default') && isAdmin();
      
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Isolated collection for private financial settings (P1-01)
    match /privateFinancialSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // F-11: Operational Settings restricted to Admin/SuperAdmin only
    match /operationalSettings/{docId} {
      allow get, list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /publicPlatformSettings/{docId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 20. Seller Subscription Plans (Public read, admin write)
    match /sellerPlans/{planId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // 21. Seller Subscriptions (F-10 & F-23: Activation strictly super-admin/server-controlled; plan & financial fields verified)
    match /subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() &&
        incoming().sellerId == request.auth.uid &&
        incoming().status in ['PENDING_PAYMENT', 'PENDING_REVIEW'] &&
        incoming().planId is string &&
        exists(/databases/$(database)/documents/sellerPlans/$(incoming().planId)) &&
        (!('planPrice' in incoming()) || incoming().planPrice == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.price) &&
        (!('price' in incoming()) || incoming().price == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.price) &&
        (!('commissionRate' in incoming()) || incoming().commissionRate == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.commissionRate) &&
        (!('approvedBy' in incoming())) &&
        (!('approvedAt' in incoming())) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['UNPAID', 'PENDING', 'pending', 'unpaid']);
      allow update: if isSuperAdmin() || (
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt'])
      ) || (
        isActiveUser() &&
        resource.data.sellerId == request.auth.uid &&
        incoming().sellerId == existing().sellerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentReferenceNumber', 'notes', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Compatibility alias for sellerSubscriptions (F-23)
    match /sellerSubscriptions/{subscriptionId} {
      allow get, list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() &&
        incoming().sellerId == request.auth.uid &&
        incoming().status in ['PENDING_PAYMENT', 'PENDING_REVIEW'] &&
        incoming().planId is string &&
        exists(/databases/$(database)/documents/sellerPlans/$(incoming().planId)) &&
        (!('planPrice' in incoming()) || incoming().planPrice == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.price) &&
        (!('price' in incoming()) || incoming().price == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.price) &&
        (!('commissionRate' in incoming()) || incoming().commissionRate == get(/databases/$(database)/documents/sellerPlans/$(incoming().planId)).data.commissionRate) &&
        (!('approvedBy' in incoming())) &&
        (!('approvedAt' in incoming())) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['UNPAID', 'PENDING', 'pending', 'unpaid']);
      allow update: if isSuperAdmin() || (
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt'])
      ) || (
        isActiveUser() &&
        resource.data.sellerId == request.auth.uid &&
        incoming().sellerId == existing().sellerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentReferenceNumber', 'notes', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // 22. Commission Policies (F-14: Restricted to Admin / Super Admin only)
    match /commissionPolicies/{policyId} {
      allow get, list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // 23. Featured Listings (Public read, admin write)
    match /featuredListings/{listingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // 24. Promotion Requests (F-22: Restricted financial & approval fields on seller creation)
    match /promotionRequests/{requestId} {
      allow get, list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() &&
        incoming().sellerId == request.auth.uid &&
        incoming().status in ['PENDING_REVIEW', 'PENDING_PAYMENT'] &&
        (!('price' in incoming()) || (incoming().price is number && incoming().price >= 0)) &&
        (!('durationDays' in incoming()) || (incoming().durationDays is number && incoming().durationDays >= 1 && incoming().durationDays <= 365)) &&
        (!('approvedBy' in incoming())) &&
        (!('approvedAt' in incoming())) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['UNPAID', 'PENDING', 'pending', 'unpaid']);
      allow update: if isAdmin() || (
        isActiveUser() &&
        resource.data.sellerId == request.auth.uid &&
        incoming().sellerId == existing().sellerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentReferenceNumber', 'notes', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // 25. Ad Campaigns (Activation strictly admin-controlled; F-06 Privacy: financial fields restricted to owner/admin)
    match /campaigns/{campaignId} {
      allow get, list: if (
        (!('budget' in resource.data) && !('spent' in resource.data) && !('paymentReference' in resource.data) && !('paymentReferenceNumber' in resource.data) && (resource.data.status in ['ACTIVE', 'active'])) ||
        (isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.advertiserId == request.auth.uid || isAdmin()))
      );
      allow create: if isActiveUser() &&
        (incoming().sellerId == request.auth.uid || incoming().advertiserId == request.auth.uid) &&
        (incoming().status in ['DRAFT', 'PENDING_REVIEW']) &&
        (!('spent' in incoming()) || incoming().spent == 0) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['UNPAID', 'PENDING', 'pending', 'unpaid']);
      allow update: if (
        isSuperAdmin() ||
        (isAdmin() &&
         incoming().sellerId == existing().sellerId &&
         (!('advertiserId' in existing()) || incoming().advertiserId == existing().advertiserId) &&
         incoming().budget == existing().budget &&
         (!('spent' in existing()) || incoming().spent == existing().spent) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'status', 'rejectionReason', 'approvedBy', 'approvedAt', 'notes', 'updatedAt'
         ])) ||
        (isActiveUser() &&
         (resource.data.sellerId == request.auth.uid || resource.data.advertiserId == request.auth.uid) &&
         incoming().sellerId == existing().sellerId &&
         (!('advertiserId' in existing()) || incoming().advertiserId == existing().advertiserId) &&
         incoming().budget == existing().budget &&
         incoming().diff(existing()).affectedKeys().hasOnly(['paymentReferenceNumber', 'notes', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Compatibility alias for adCampaigns (F-06 Privacy: financial fields restricted to owner/admin)
    match /adCampaigns/{campaignId} {
      allow get, list: if (
        (!('budget' in resource.data) && !('spent' in resource.data) && !('paymentReference' in resource.data) && !('paymentReferenceNumber' in resource.data) && (resource.data.status in ['ACTIVE', 'active'])) ||
        (isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.advertiserId == request.auth.uid || isAdmin()))
      );
      allow create: if isActiveUser() &&
        (incoming().sellerId == request.auth.uid || incoming().advertiserId == request.auth.uid) &&
        (incoming().status in ['DRAFT', 'PENDING_REVIEW']) &&
        (!('spent' in incoming()) || incoming().spent == 0) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['UNPAID', 'PENDING', 'pending', 'unpaid']);
      allow update: if (
        isSuperAdmin() ||
        (isAdmin() &&
         incoming().sellerId == existing().sellerId &&
         (!('advertiserId' in existing()) || incoming().advertiserId == existing().advertiserId) &&
         incoming().budget == existing().budget &&
         (!('spent' in existing()) || incoming().spent == existing().spent) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'status', 'rejectionReason', 'approvedBy', 'approvedAt', 'notes', 'updatedAt'
         ])) ||
        (isActiveUser() &&
         (resource.data.sellerId == request.auth.uid || resource.data.advertiserId == request.auth.uid) &&
         incoming().sellerId == existing().sellerId &&
         (!('advertiserId' in existing()) || incoming().advertiserId == existing().advertiserId) &&
         incoming().budget == existing().budget &&
         incoming().diff(existing()).affectedKeys().hasOnly(['paymentReferenceNumber', 'notes', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // 25b. Public Ad Campaign Projections (Sanitized public view without budget, spent, paymentReference)
    match /adCampaigns_public/{campaignId} {
      allow get, list: if !('budget' in resource.data) && !('spent' in resource.data) && !('paymentReference' in resource.data) && !('paymentReferenceNumber' in resource.data);
      allow write: if isAdmin();
    }

    // 26. Coupons Engine (Public/User read for validation, admin or verified store owner write - Finding 16 & F-05)
    match /coupons/{couponId} {
      allow get, list: if true && (!('customerUsage' in resource.data) || resource.data.customerUsage == null || isAdmin());
      allow create: if isAdmin() || (
        isActiveUser() &&
        'sellerId' in incoming() &&
        incoming().sellerId is string &&
        incoming().sellerId.size() > 0 &&
        incoming().sellerId == request.auth.uid &&
        'storeId' in incoming() &&
        incoming().storeId is string &&
        exists(/databases/$(database)/documents/stores/$(incoming().storeId)) &&
        get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.sellerId == request.auth.uid &&
        incoming().usedCount == 0 &&
        incoming().discountValue is number &&
        incoming().discountValue > 0 &&
        (incoming().discountType != 'percentage' || incoming().discountValue <= 100)
      );
      allow update: if isAdmin() || (
        isActiveUser() &&
        'sellerId' in resource.data &&
        resource.data.sellerId is string &&
        resource.data.sellerId.size() > 0 &&
        resource.data.sellerId == request.auth.uid &&
        incoming().sellerId == resource.data.sellerId &&
        (!('storeId' in incoming()) || incoming().storeId == resource.data.storeId) &&
        incoming().usedCount == resource.data.usedCount &&
        (!('customerUsage' in incoming()) || incoming().customerUsage == existing().customerUsage) &&
        incoming().discountValue is number &&
        incoming().discountValue > 0 &&
        (incoming().discountType != 'percentage' || incoming().discountValue <= 100)
      );
      allow delete: if isAdmin() || (isActiveUser() && resource.data.sellerId == request.auth.uid);
    }

    // 26b. Inventory Logs (F-11 Tenant Isolation: restricted to owning seller and admin)
    match /inventory_logs/{logId} {
      allow get, list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && incoming().sellerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // P1-PRIVATE-02: Isolated Customer Coupon Usage (Private, customer or admin read only, server-only write)
    match /couponUsages/{usageId} {
      allow get, list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 27. Refund Requests Collection
    // Financial transactions must be created, reviewed, and settled exclusively via trusted server gateways (/api/refunds/*) via Admin SDK
    match /refundRequests/{requestId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      // Direct client creation & updates strictly DENIED; Admin SDK gateway only (Finding 4 & Finding 18)
      allow create, update, delete: if false;
    }

    // 28. Analytics Events (Exclusively ingested via backend gateway /api/analytics/event; direct client creation denied)
    match /analyticsEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isSuperAdmin();
    }

    // 29. Authoritative User Favorites Collection (Cross-device, persisted, user-isolated)
    match /userFavorites/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isActiveUser() && request.auth.uid == userId &&
        incoming().userId == userId &&
        incoming().productIds is list &&
        incoming().productIds.size() <= 500;
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // 30. Authoritative User Followed Stores Collection (Cross-device, persisted, user-isolated)
    match /userFollows/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isActiveUser() && request.auth.uid == userId &&
        incoming().userId == userId &&
        incoming().storeIds is list &&
        incoming().storeIds.size() <= 500;
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin());
    }
  }
}
